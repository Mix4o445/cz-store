PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/coolzone
# Supabase (PostgreSQL). The backend uses the service-role key — keep it secret.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Cloudinary (optional for Phase 1)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CMI (Phase 3)
CMI_MERCHANT_ID=
CMI_SECRET_KEY=
# SMTP (order confirmation emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CoolZone <noreply@coolzone.ma>"
ADMIN_EMAIL=admin@coolzone.ma
# AI Admin Assistant (NVIDIA NIM — OpenAI-compatible API)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Optional: richer web search for the AI assistant (https://tavily.com). Falls back to DuckDuckGo if empty.
TAVILY_API_KEY=
